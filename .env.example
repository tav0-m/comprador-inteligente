APP_ENV=local
DATABASE_URL=sqlite:///./smart_buyer.db
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900

# Genera una clave larga y aleatoria. Nunca la expongas en NEXT_PUBLIC_*.
ADMIN_API_KEY=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","api"]
RATE_LIMIT_PER_MINUTE=30

ENABLE_SERPAPI=false
SERPAPI_KEY=
ENABLE_MERCADOLIBRE=true
ENABLE_LOCAL_CSV=true
ENABLE_SODIMAC=true
ENABLE_EASY=true
ENABLE_FALABELLA=true
ENABLE_PARIS=true
ENABLE_CONSTRUMART=true

DEFAULT_COUNTRY=cl
REQUEST_TIMEOUT_SECONDS=25
SEARCH_TIMEOUT_SECONDS=40
PRICE_FRESHNESS_HOURS=24

ALERT_EMAIL_FROM=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_SMTP=smtp.gmail.com
ALERT_EMAIL_PORT=587
