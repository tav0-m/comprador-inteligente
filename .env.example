APP_ENV=local
DATABASE_URL=sqlite:///./smart_buyer.db
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900

# Genera claves largas y aleatoria: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Nunca las expongas en NEXT_PUBLIC_*.
ADMIN_API_KEY=
# Firma enlaces de confirmacion/baja de alertas y seudonimiza IPs del feedback.
APP_SECRET_KEY=
# URL publica del API usada en los enlaces de los emails (via frontend: http://localhost:3000/api)
PUBLIC_API_URL=http://localhost:8000
# Proxies de confianza cuyo X-Forwarded-For se acepta (en Docker: red interna del frontend)
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","api"]
RATE_LIMIT_PER_MINUTE=30
FEEDBACK_LIMIT_PER_MINUTE=20
ALERT_CREATE_LIMIT_PER_HOUR=5
ALERT_MAX_ACTIVE_PER_EMAIL=10
ALERT_MAX_NEW_PER_EMAIL_PER_DAY=3
FEEDBACK_MAX_OFFER_AGE_DAYS=7

ENABLE_SERPAPI=false
SERPAPI_KEY=
ENABLE_MERCADOLIBRE=true
# App en https://developers.mercadolibre.cl (sin credenciales la fuente se omite)
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
ENABLE_LOCAL_CSV=true
ENABLE_SODIMAC=true
ENABLE_EASY=true
ENABLE_FALABELLA=true
ENABLE_PARIS=true
ENABLE_CONSTRUMART=false

DEFAULT_COUNTRY=cl
REQUEST_TIMEOUT_SECONDS=25
SEARCH_TIMEOUT_SECONDS=40
PRICE_FRESHNESS_HOURS=24

ALERT_EMAIL_FROM=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_SMTP=smtp.gmail.com
ALERT_EMAIL_PORT=587
